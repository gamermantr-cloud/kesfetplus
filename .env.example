# This file is an example. Copy it to ".env" and fill in real values later.
# Do not put real secrets in this file.

# Application
APP_ENV=development

# Database (not connected yet - placeholder only)
DATABASE_URL=postgresql://user:password@localhost:5432/kesfetplus

# AI Provider (not connected yet - placeholder only)
OPENAI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here

# Place/discovery data sources (see docs/INTEGRATIONS.md)
GOOGLE_PLACES_API_KEY=your-key-here
FOURSQUARE_API_KEY=your-key-here
TRIPADVISOR_API_KEY=your-key-here
AMADEUS_API_KEY=your-key-here
AMADEUS_API_SECRET=your-secret-here

# Real-time messaging (for the "anlik bilgi akisi" feature)
ABLY_API_KEY=your-key-here

# Web Push (VAPID, RFC 8292) - real check-in/status push notifications.
# No third-party account/API key needed (unlike FCM/APNs) - this is a
# self-generated EC key pair. Generate a real pair with:
#   venv\Scripts\python.exe scripts\generate_vapid_keys.py
# then paste its output below. Leaving these empty is fine in dev: push
# sends are then honestly skipped (logged, never faked) - see
# database/push_notify.py and GET /push/vapid-public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Real contact address - required by RFC 8292 ("sub" claim); push services
# may use it to reach you about abuse. Prefixed with mailto: e.g.
# VAPID_CLAIMS_EMAIL=mailto:you@example.com
VAPID_CLAIMS_EMAIL=

# Trust-scoring / moderation (see docs/INTEGRATIONS.md)
SIFT_API_KEY=your-key-here
HIVE_API_KEY=your-key-here

# Moderation panel access (MVP - no admin UI yet, see database/users_store.py
# "MODERATION MVP" note). Comma-separated list of account emails that get
# is_moderator=true on register/login and can see /moderation/* endpoints
# and the "Moderasyon Paneli" screen. Example:
# MODERATOR_EMAILS=you@example.com,teammate@example.com
MODERATOR_EMAILS=

# Monitoring
SENTRY_DSN=your-dsn-here
