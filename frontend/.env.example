# Production/native API base URL (used by src/lib/api.js when NOT in Vite
# dev mode - i.e. `npm run build` / Capacitor iOS/Android builds). In dev
# (`npm run dev`) this is ignored; requests go through the Vite /api proxy
# to 127.0.0.1:8000 instead (see vite.config.js).
#
# PLACEHOLDER - api.kesfetplus.com does not exist yet, there is no backend
# hosting set up. Replace with the real backend origin once it's deployed,
# then copy this file to `.env.production` (or `.env`) with the real value.
# No trailing /api - the backend routes live at the root (e.g. /auth/login),
# same as what the dev proxy rewrites /api/... down to.
VITE_API_BASE_URL=https://api.kesfetplus.com
